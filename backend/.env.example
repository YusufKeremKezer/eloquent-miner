# App
APP_NAME="Eloquent Miner"
APP_ENV=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Paths
DATABASE_URL=sqlite:///./data/db/app.db
MEDIA_DIR=./data/media
JOBS_DIR=./data/jobs

# ffmpeg
FFMPEG_PATH=ffmpeg

# Upload limits
MAX_UPLOAD_SIZE_MB=500
MAX_CLIP_SECONDS=12

# Feature flags
ENABLE_TRANSCRIPT_UPLOAD=true
ENABLE_SUBTITLE_UPLOAD=true
ENABLE_AUDIO_UPLOAD=true
ENABLE_VIDEO_UPLOAD=false
ENABLE_YOUTUBE_URL=true
ENABLE_YOUTUBE_SEARCH=false
ENABLE_YOUTUBE_DOWNLOAD=true

# LLM provider
LLM_PROVIDER=openrouter
LLM_MODEL=deepseek/deepseek-v4-flash

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# YouTube settings
YOUTUBE_AUDIO_FORMAT=mp3
YOUTUBE_SUBTITLE_LANGS=en

# Anki export
ANKI_DECK_NAME="Eloquent Miner"
ANKI_TAG="eloquence"